// ─────────────────────────────────────────────────────────────────────────────
// Tantaropic — Prisma Schema
// Sharia-compliant micro-investment platform
// Fully aligned with docs/entities.md
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum LedgerEntryType {
  ROUNDUP
  USER_DEPOSIT
  USER_WITHDRAWAL
  INVESTMENT_ALLOCATION
  INVESTMENT_REDEMPTION
  FUND_FEE         // On User Deposit and RoundUp
  PROFIT_FEE       // on asset redemption Profit
}

enum AssetClass {
  FIAT
  GOLD
  INDEX_FUND
  HIGH_RISK
}

enum RiskProfile {
  DEFAULT
  CONSERVATIVE
  AGGRESSIVE
}

enum Currency {
  EGP
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// ─── Profile ────────────────────────────────────────────────────────────────
// A profile groups one or more users (family, friends).
// The shared DigitalWallet belongs to the Profile, not individual users.

model Profile {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── for Optimistic Concurrency Control ───
  version   Int      @default(1)

  aum       BigInt   @default(0)

  users  User[]
  wallet DigitalWallet?

  @@map("profiles")
}

// ─── User ───────────────────────────────────────────────────────────────────
// FK → Profile. Stores demographics, target goals, risk profile, and AUM.

model User {
  id          String      @id @default(uuid())
  profileId   String
  email       String      @unique
  name        String
  riskProfile RiskProfile @default(DEFAULT)
  targetGoal  BigInt?
  roundUpStep BigInt      @default(10)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  profile       Profile            @relation(fields: [profileId], references: [id])
  transactions  TransactionEvent[]
  ledgerEntries LedgerEntry[]
  aiInsights    AiInsight[]
  goals         Goal[]

  @@index([profileId])
  @@map("users")
}

model Goal {
  id             String     @id @default(uuid())
  userId         String
  title          String
  emoji          String     @default("target")
  targetAmount   BigInt
  targetDate     DateTime?
  monthlyRoundup BigInt     @default(0)
  color          String     @default("#2d7a4f")
  status         GoalStatus @default(ACTIVE)
  sortOrder      Int        @default(0)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

// ─── TransactionEvent ───────────────────────────────────────────────────────
// Raw webhook payload from MockBankAPI. One row per purchase. FK → User.

model TransactionEvent {
  id            String    @id @default(uuid())
  userId        String
  idempotencyKey String @unique

  transactionId String    @unique
  merchantTag   String
  amount        BigInt
  roundUpAmount BigInt    @default(0)
  currency      Currency    @default(EGP)
  rawPayload    Json?
  occurredAt    DateTime
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  user          User          @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
  aiInsights    AiInsight[]

  @@index([userId])
  @@map("transaction_events")
}

// ─── DigitalWallet ──────────────────────────────────────────────────────────
// FK → Profile (shared wallet). Tracks current holdings per asset class.
// Uses SELECT...FOR UPDATE during withdrawals to prevent overdraw.

model DigitalWallet {
  id        String   @id @default(uuid())
  profileId String   @unique

  // ─── for Optimistic Concurrency Control ───
  version   Int      @default(1)

  // ─── balances ───
  fiatBalance     BigInt   @default(0) // raw cash
  positions         WalletPosition[]

  // ─── metadata ───
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile       Profile       @relation(fields: [profileId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("digital_wallets")
}

// ─── WalletPosition / investments ─────────────────────────────────────────────────────────

model WalletPosition {
  id                   String        @id @default(uuid())
  walletId             String
  assetClass           AssetClass
  totalUnits           BigInt        // How many grams/shares they own (smallest unit)
  averageBuyPrice      BigInt        // avg of all buys of this asset, used to calculate if they are in profit or loss

  // ─── for Optimistic Concurrency Control ───
  version              Int           @default(1)

  wallet               DigitalWallet @relation(fields: [walletId], references: [id])

  // ─── metadata ───
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([walletId, assetClass]) // A wallet can only have one combined position per asset

  @@map("wallet_positions")
}

// ─── LedgerEntry ──────────────────────────────────────────────────────────────
// Unified ledger. FK → User, FK → DigitalWallet.
// Multiple entries can reference the same TransactionEvent (NOT unique).

model LedgerEntry {
  id                 String          @id @default(uuid())
  userId             String
  walletId           String?
  type               LedgerEntryType
  amount             BigInt
  currency           Currency          @default(EGP)

  // ─── Track shares and price to sync with MockExchangeAPI ───
  assetClass         AssetClass?
  assetUnits         BigInt?         // The number of shares/grams bought
  executionPrice     BigInt?         // The price of the asset at the time of trade

  transactionEventId String?
  idempotencyKey     String?         @unique
  note               String?
  createdAt          DateTime        @default(now())

  user             User              @relation(fields: [userId], references: [id])
  wallet           DigitalWallet?    @relation(fields: [walletId], references: [id])
  transactionEvent TransactionEvent? @relation(fields: [transactionEventId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([transactionEventId])
  @@map("ledger_entries")
}

// ─── AiInsight ──────────────────────────────────────────────────────────────
// AI-generated emotional nudges. FK → User, optional FK → TransactionEvent.

model AiInsight {
  id                 String   @id @default(uuid())
  userId             String
  transactionEventId String?
  idempotencyKey     String?  @unique
  message            String
  triggerTag         String?
  createdAt          DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id])
  transactionEvent TransactionEvent? @relation(fields: [transactionEventId], references: [id])

  @@index([userId])
  @@map("ai_insights")
}
